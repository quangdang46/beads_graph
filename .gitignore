# Build
target/
crates/*/target/

# Node (static site export artifacts)
node_modules/
dist/

# Beads local DB state (JSONL export IS committed; DB is not)
.beads/*.db
.beads/*.db-journal
.beads/*.db-fsqlite-ns-*
.beads/*.db-lock-*
.beads/*.db-wal-lock-*
.beads/.beads.vacuum.*

# Per-developer beads sidecars written by bv/bvr next to issues.jsonl. Go's
# loader allowlists only issues.jsonl / beads.jsonl / beads.base.jsonl and
# explicitly never discovers these (see its README "Sidecars such as
# sync_base.jsonl, sprints.jsonl, correlation_feedback.jsonl ... require an
# explicit file override"), so they carry no shared state worth committing.
.beads/sprints.jsonl
.beads/correlation_feedback.jsonl
.beads/sync_base.jsonl
.beads/deletions.jsonl

# Persistent semantic search index (bv_search::index_sync default path;
# rebuilt on demand from .beads/issues.jsonl, same convention Go bv uses —
# neither binary commits this).
.bv/

# ...except the hooks-loader fixtures, which are test data and only readable at
# `.bv/hooks.yaml` because that is the path Go's `pkg/hooks` loader reads
# (config.go:114-119). hooks_loader_parity.rs needs the directory name to
# match; without this negation `git add -A` silently skips them, which is how
# the whole tree went missing in the first place.
!crates/bv-export/tests/fixtures/hooks/**/.bv/
!crates/bv-export/tests/fixtures/hooks/**/.bv/**

# Upstream reference clone (local only — do not publish Go source in Rust repo)
beads_viewer/

# Go oracle binary built by scripts/capture_goldens.sh for differential runs.
# A ~60 MB local build artifact; never commit it.
scripts/.bv-go
scripts/.bv-go.exe

# Scratch dir used by parity/differential harnesses while porting. Not source.
tmp/

# Instance lock files. Contents are just {"pid":N}, so every run dirties the
# tree and every diff is noise. The four tracked ones under tests/fixtures/ are
# kept in git for history but must not be committed with a fresh pid.
.bv.lock
**/.bv.lock

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Env
.env
.env.*

# Fixture-local beads state
tests/fixtures/*/.beads/*.db*
handoff.txt
.claude/worktrees/
tests/fixtures/small_chain/.beads/.bv.lock

# Editor/agent scratch backups. Never source; an agent left these mid-edit.
*.bak
*.bak2

# Artifacts of the single-dash rewriter bug (fixed in 3ca4ce1): a value like
# -1e400 was treated as a flag name and an export was written into a directory
# with that name. Guarded so one can never be committed.
/--*/
/-*/

# Output of `--generate-docs`; a build product, never committed.
docs/generated/

# Local export/preview output from a `--pages`, `--export-pages`,
# `--export-graph` or `--preview-pages` run. These are build products of a
# test, not sources; several land in the repository root because the flags
# take a bare path.
bv-pages/
bvr-ev-real/
bvr-sym/
out/
iso/
filt/
dot.svg
json.svg
mermaid.svg
beads_graph.json
html
# An `--export-graph` run with no path derives this filename from the project
# and an --as-of stamp, so it cannot be matched by a fixed name.
beads_viewer_rust_graph_export__*.html
report.md

# A --pages wizard run whose output directory is a bare name.
/OutA/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example

# A --pages wizard run with a single-character output directory.
/O/
